<?xml version="1.0"?>
<sdf version="1.9">
  <model name="dpbot">
    <pose>0 0 0.1 0 0 0</pose>
    <link name="chassis">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.3 0.2 0.1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 0.2 0.1</size></box></geometry></visual>
    </link>
    <link name="left_wheel">
      <pose>0 0.13 0.05 -1.5707 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.13 0.05 -1.5707 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="caster"><pose>-0.12 0 0.02 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.02</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.02</radius></sphere></geometry></visual>
    </link>
    <joint name="left_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="right_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="caster_joint" type="ball"><parent>chassis</parent><child>caster</child></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_joint</left_joint>
      <right_joint>right_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>dpbot</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
